        {
          "board": "AQA",
          "topics": [
            {
              "title": "Algebraic Fundamentals",
              "learningObjectives": ["Simplify algebraic expressions","Factorise quadratic expressions","Solve linear and quadratic equations"],
              "keyPoints": ["Collect like terms","Difference of two squares","Quadratic formula"],
              "exampleQuestion": "Factorise x\u00b2 - 5x + 6",
              "modelAnswer": "(x - 2)(x - 3)",
              "practiceQuestions": ["Factorise x\u00b2 + 7x + 10","Solve x\u00b2 - 4 = 0","Expand (x + 3)(x - 2)"]
            },
            {
              "title": "Coordinate Geometry",
              "learningObjectives": ["Find equation of a line","Calculate gradient","Determine intersection of lines"],
              "keyPoints": ["Gradient formula y = mx + c","Two‑point form","Parallel/perpendicular gradients"],
              "exampleQuestion": "Find the equation of the line through (1,2) and (3,6)",
              "modelAnswer": "y = 2x",
              "practiceQuestions": ["Find line through (0,0) and (2,5)","Determine if lines y=2x+1 and y=2x-3 are parallel","Find intersection of y = x+1 and y = -x+3"]
            },
            {
              "title": "Differentiation",
              "learningObjectives": ["Differentiate polynomials","Find stationary points","Apply second derivative test"],
              "keyPoints": ["Power rule","Stationary point = f'(x)=0","Second derivative test (max/min/inflection)"],
              "exampleQuestion": "Differentiate f(x) = 3x\u00b3 - 5x\u00b2 + 2x",
              "modelAnswer": "f'(x) = 9x\u00b2 - 10x + 2",
              "practiceQuestions": ["Differentiate x\u00b4 - 3x\u00b2","Find stationary points of y = x\u00b3 - 3x","Classify each stationary point"]
            },
            {
              "title": "Integration",
              "learningObjectives": ["Integrate polynomials","Definite integrals","Area under a curve"],
              "keyPoints": ["Increase power by 1 then divide","∫ₐᵇ f(x)dx = F(b)-F(a)","Area between curve and x‑axis"],
              "exampleQuestion": "Integrate ∫(4x\u00b3 - 2x) dx",
              "modelAnswer": "x\u00b4 - x\u00b2 + C",
              "practiceQuestions": ["∫(3x\u00b2 + 5x) dx","Area under y = x\u00b2 from x=0 to x=2","∫₁³ (2x + 1) dx"]
            },
            {
              "title": "Trigonometry",
              "learningObjectives": ["Use sine/cosine rules","Sketch trig graphs","Solve trig equations"],
              "keyPoints": ["SOH CAH TOA","sin²θ + cos²θ = 1","Graph period and amplitude"],
              "exampleQuestion": "Solve sinθ = √3/2 for 0 ≤ θ < 2π",
              "modelAnswer": "θ = π/3, 2π/3",
              "practiceQuestions": ["Solve cosθ = -1/2","Sketch y = 2 sin x for 0≤x≤2π","Use sine rule to find missing side in triangle"]
            }
          ]
        },
